{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MF Translator",
  "version": "0.1.0",
  "identifier": "com.mftranslator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MF 翻译",
        "width": 960,
        "height": 640,
        "minWidth": 780,
        "minHeight": 540,
        "center": true
      },
      {
        "label": "quick",
        "title": "MF 快捷翻译",
        "width": 420,
        "height": 560,
        "resizable": true,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
